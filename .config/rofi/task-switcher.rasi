@import "/home/burak/.cache/wal/colors-rofi-dark.rasi"

* {
    background-color: @background;
    text-color: @foreground;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
    font: "Mono 9";
}

window {
    background-color: @background;
    border-radius: 12px;
    width: 900px;
    padding: 20px;
}

mainbox {
    children: [ listview ];
}

listview {
    lines: 3;
    columns: 6;
    scrollbar: false;
    spacing: 20px;
    cycle: true;
    dynamic: true;
}

element {
    padding: 25px 15px;
    border-radius: 8px;
    spacing: 8px;
    children: [ element-icon, element-text ];
    orientation: vertical;
}

element selected {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
    border-radius: 12px;
}

element normal {
    background-color: @active-background;
    text-color: @active-foreground;
}

element alternate {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

element-icon {
    size: 64px;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    margin: 8px 0px 0px 0px;
    background-color: transparent;
    horizontal-align: 0.5;
}
